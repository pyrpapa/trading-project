.env
data/cache/
__pycache__/
*.pyc
.DS_Store
# Root-level node_modules -- exists now that /api/sell.js needs
# @supabase/supabase-js resolved from a root package.json (Vercel's
# Root Directory is the repo root; dashboard/node_modules stays covered
# by dashboard/.gitignore separately, unaffected by this one).
node_modules/

# Generated backtest artifacts (HTML chart reports, CSV/markdown exports).
# These are fully regeneratable from a config file + `python run_backtest.py
# --config ... --chart --save --label ...`, and the durable copy already
# lives in Supabase (backtest_runs/trades tables) via --save -- committing
# them here just bloats the repo with derived data. Local files stay on
# disk, just untracked.
results/*.html
results/*_summary.md
results/*_trades.csv
/*_summary.md
/*_trades.csv

# Same rationale, for parameter_sweep.py's output -- fully regeneratable
# with `python parameter_sweep.py`.
results/parameter-sweep/

# Same rationale, for holdout_test.py's output -- fully regeneratable
# with `python holdout_test.py`.
results/holdout-test/
