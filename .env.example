# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — add it to .gitignore.

# Find these in your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# The service_role key bypasses Row Level Security — that's intended
# for this backend script, but it must never be exposed in frontend
# code or a public repo. Use the anon/public key + RLS policies for
# anything that runs in the browser.

# --- Alpaca (paper trading) ---
# Sign up at https://alpaca.markets — a paper trading account is
# created automatically, no separate application needed.
# Get keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your-paper-api-key-here
ALPACA_SECRET_KEY=your-paper-secret-key-here
ALPACA_PAPER=true
# Leave ALPACA_PAPER=true. The code has a hard safeguard that refuses
# to run if this is set to false — that's intentional, remove it
# yourself only when you've deliberately decided to go live.

