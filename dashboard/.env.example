# Copy to .env and fill in. These are the PUBLIC anon key — safe to
# expose in frontend code, unlike the service_role key used by the
# Python backend. Find both in Supabase: Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# api/quotes.js (live "current price" for open positions) needs these
# too -- deliberately NOT prefixed VITE_, so Vite never bundles them into
# client-side code. On Vercel, set these as regular Project Environment
# Variables (Settings -> Environment Variables), not in this file/the
# dashboard's own .env. Same paper-account keys already used by
# live/run_live.py.
#
# ALPACA_API_KEY=...
# ALPACA_SECRET_KEY=...
#
# To test api/quotes.js locally, plain `npm run dev` (Vite) won't serve
# /api routes -- use `npx vercel dev` instead, which needs both these in
# your local .env too.

# api/sell.js (the per-position Sell button) needs one more, also NOT
# VITE_-prefixed: a fine-grained GitHub PAT scoped to Actions read/write
# on this repo only -- same permission shape as the cron-job.org token,
# but deliberately a SEPARATE token so the two can be rotated/revoked
# independently. It's what lets the dashboard trigger
# close-position.yml on your behalf; it can't do anything else (no repo
# contents/PR access). Create one at GitHub -> Settings -> Developer
# settings -> Fine-grained tokens.
#
# GITHUB_DISPATCH_TOKEN=github_pat_...

# api/run_backtest.py (the Backtest page) runs as a Vercel PYTHON
# function with direct access to this repo's real strategy/backtest/
# data/storage modules -- it doesn't dispatch a GitHub Actions workflow
# the way api/sell.js does, it runs the backtest itself and returns
# results directly. It needs VITE_SUPABASE_URL/ANON_KEY (to verify
# you're logged in) plus the SAME SUPABASE_URL/SUPABASE_SERVICE_KEY
# already in the repo root's own .env.example -- those aren't VITE_-
# prefixed either, set them as Vercel Project Environment Variables the
# same way as everything else here, not in this file. This only works
# at all because the Vercel project's Root Directory is the REPO ROOT,
# not dashboard/ -- see README.md's "Deploying to Vercel" section.
